# Main Program
# --------------------------------------------------

start = "A"
goal = "L"

print("======================================")
print("   EMERGENCY RESCUE ROUTE PLANNER")
print("======================================")

print("\nStart Location :", start)
print("Patient Location:", goal)


# BFS
bfs_path = bfs(graph, start, goal)

print("\n1. BREADTH FIRST SEARCH (BFS)")
print("Path:", " -> ".join(bfs_path))
print("Number of steps:", len(bfs_path) - 1)


# UCS
ucs_path, total_cost = ucs(graph, cost, start, goal)

print("\n2. UNIFORM COST SEARCH (UCS)")
print("Path:", " -> ".join(ucs_path))
print("Minimum Cost:", total_cost)


# IDS
ids_path, depth = ids(graph, start, goal, 10)

print("\n3. ITERATIVE DEEPENING SEARCH (IDS)")
print("Path:", " -> ".join(ids_path))
print("Depth:", depth)
